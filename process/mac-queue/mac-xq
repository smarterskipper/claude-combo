#!/bin/bash
# xq - build queue + per-session simulators for the shared build Mac. EVERY session
# (Menos, Yarrow, anything) runs xcodebuild / simulator / archive work through it.
#   xq <session> -- <cmd...>   run cmd when the slot is free; jobs start strictly in arrival order
#   xq sim <session>           print UDID of sim "xq-<session>" (create, boot, health-check)
#   xq status                  slot holders, waiters, xq-* sims, last check-in
#   xq checkin <session>       the session holding the slot says "still alive" (do this every 5 min
#                              while you hold it for anything idle; busy jobs check in on their own)
#   xq kick <session>          stop that session's job and free the slot (only after asking the
#                              other sessions and nobody claimed it)
#   xq gc                      shut down xq-* sims whose session has been idle > 30 min
#   xq prune [--older-than 2d] [--dry-run]   delete shut-down run simulators unused that long
#   xq drop <session>          delete xq-<session>-<n>, the simulators of one finished xq test run
#   xq lease <session> <n> <pid>   take up to n of xq test's pool simulators (xq-pool-<k>) for job pid <pid>;
#                              prints "pool-<k> warm|cold|new" per line, nothing for a long-lived session name
#   xq ready <pool-k>          boot it and wipe what the last run left; prints its UDID (fails: it was deleted)
#   xq unlease <pid> <pool-k>...   hand them back (a dead or over-time pid's lease ends by itself)
# The pool: one shared set of booted iPhone simulators per Mac, at most XQ_POOL_MAX (2 per slot), so a run skips
# the create and the 50 s first boot. ready uninstalls every user app (data and app-group containers go with
# them) and resets the keychain, permissions and pasteboard. A run that wrote to Photos, Contacts, Calendar or
# Health gets its simulator erased instead. Slot grabs leave pool simulators booted; one unused for XQ_POOL_IDLE
# (2h) is shut down, and prune deletes it like any other run simulator.
# Run simulators are what `xq sim` makes: an iPhone 17 Pro on the default runtime. prune and drop never touch
# other devices or runtimes, the POOL below, names in ~/.config/xq/keep-sims (one glob per line), a booted
# simulator (prune), or one whose session holds a slot or waits for one. When a job gets its slot with under
# XQ_LOW_GB (30) GB free, xq warns and first prunes what has been unused for XQ_LOW_AGE (3h).
# Stale jobs are removed: a waiter whose session died leaves the line; a slot whose holder
# died, or that has run longer than XQ_MAX_RUN seconds (default 5400 = 90 min), is freed
# (an over-time holder is stopped first). Check-ins: a holder that keeps using CPU checks in
# automatically every XQ_BEAT s (60); otherwise its session must run `xq checkin <session>`.
# No check-in for XQ_CHECKIN s (300) = MISSED (waiters are warned); for XQ_HUNG s (600) = HUNG,
# and the head waiter stops it and takes the slot.
# Env: XQ_MAC_SLOTS (this Mac's default is on the SLOTS= line; setup-mac.sh <mac> xq keeps it), XQ_MAX_RUN,
# XQ_BEAT, XQ_CHECKIN, XQ_HUNG, XQ_RUNTIME (for new simulators), XQ_LOW_GB, XQ_LOW_AGE, XQ_POOL_MAX, XQ_POOL_IDLE.
# Jobs get XQ_SLOT (slot number) and XQ_SESSION in their environment (used by ~/bin/ci for warm lanes).
# State lives in /tmp/xq. Only ever touches simulators named xq-*.
set -u
Q=${XQ_DIR:-/tmp/xq}; SLOTS=${XQ_MAC_SLOTS:-3}; MAX_RUN=${XQ_MAX_RUN:-5400}; DEVICE="iPhone 17 Pro"
BEAT=${XQ_BEAT:-60}; CHECKIN=${XQ_CHECKIN:-300}; HUNG=${XQ_HUNG:-600}
RUNTIME_DEFAULT=com.apple.CoreSimulator.SimRuntime.iOS-26-4; DEVICE_ID=com.apple.CoreSimulator.SimDeviceType.${DEVICE// /-}
LOW_GB=${XQ_LOW_GB:-30}; LOW_AGE=${XQ_LOW_AGE:-3h}; PY=${XQ_PY:-/usr/bin/python3}
KEEP_FILE=${XQ_KEEP_FILE:-$HOME/.config/xq/keep-sims}
POOL_MAX=${XQ_POOL_MAX:-$((SLOTS * 2))}; POOL_IDLE=${XQ_POOL_IDLE:-7200}
SIM_HOME=${XQ_SIM_HOME:-$HOME/Library/Developer/CoreSimulator/Devices}
# Shared stores an app can write to that survive its uninstall (paths under the simulator's data folder).
STORES='Library/AddressBook Library/Calendar Library/Health Media/PhotoData'
# Long-lived simulators, reused on purpose (a new one costs a cold first run, and first-boot banners in shots).
POOL='xq-tf* xq-shots-* xq-ftime-* xq-freelooks xq-fulltest xq-fulltest-*'
mkdir -p "$Q/slots" "$Q/queue" "$Q/seen" "$Q/pool"

die() { echo "xq: $*" >&2; exit 1; }
now() { date +%s; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
# macOS has no `timeout`; SIGALRM survives exec and kills the command.
with_timeout() { local s=$1; shift; perl -e 'alarm shift; exec @ARGV or die' "$s" "$@"; }
check_name() {
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "session name must match [A-Za-z0-9_-]+: '$1'"
  [[ $1 == pool || $1 == pool-* ]] && die "'$1': pool names belong to xq test's simulator pool"
  return 0
}

# Frees the slot only while it is still ours: if it was reclaimed and handed on, the new holder keeps it
# (removing it let a third job in, whose ci run then killed the new holder: slot 1 ping-ponged, 2026-10-24).
release() {
  local holder=""
  [ -n "${WATCH:-}" ] && kill "$WATCH" 2>/dev/null; rm -f "$ME"
  [ -n "$SLOT" ] && read -r holder _ 2>/dev/null < "$SLOT/info"; [ -n "$SLOT" ] && [ "$holder" = "$$" ] && rm -rf "$SLOT"
  touch "$Q/seen/$S"
}

# Seconds since the slot's holder last checked in (slot dir mtime if it never did).
checkin_age() { local f="$1/checkin"; [ -e "$f" ] || f="$1"; echo $(( $(now) - $(stat -f %m "$f" 2>/dev/null || now) )); }

# Total CPU seconds of every process under pid $1, skipping the subtree rooted at pid $2 (the watcher).
tree_cpu() {
  ps -A -o pid=,ppid=,time= | awk -v root="$1" -v skip="$2" '
    { pid=$1; pp[pid]=$2; n=split($3,a,":"); t=0; for(i=1;i<=n;i++) t=t*60+a[i]; cpu[pid]=t }
    END { for (p in pp) { q=p; ok=0
            while (q != "" && q > 1) { if (q==skip) break; if (q==root) { ok=1; break }; q=pp[q] }
            if (ok && p!=root) s+=cpu[p] }
          printf "%.2f\n", s+0 }'
}

# Background: touch the slot's checkin file whenever the job used CPU since the last beat.
watch_job() {
  local holder=$1 slot=$2 last cur me
  me=$(exec sh -c 'echo $PPID')   # this background subshell's pid (bash 3.2 has no $BASHPID)
  last=$(tree_cpu "$holder" "$me")
  while sleep "$BEAT"; do
    [ -d "$slot" ] || exit 0; alive "$holder" || exit 0
    cur=$(tree_cpu "$holder" "$me")
    awk -v a="$cur" -v b="$last" 'BEGIN{exit !(a>b)}' && touch "$slot/checkin"
    last=$cur
  done
}

# Warn (to stderr) about any live holder that has missed its check-in.
warn_missed() {
  local i d pid start s age
  for i in $(seq 1 "$SLOTS"); do
    d="$Q/slots/$i"; read -r pid start s _ 2>/dev/null < "$d/info" || continue
    alive "$pid" || continue
    age=$(checkin_age "$d"); [ "$age" -gt "$CHECKIN" ] || continue
    echo "xq: slot $i holder '$s' (pid $pid) has not checked in for $((age/60))m$((age%60))s. If it's yours: xq checkin $s. Otherwise ask the other sessions (ListAgents + SendMessage) whether it's hung; if nobody claims it: xq kick $s. It is freed automatically at $((HUNG/60))m without a check-in." >&2
  done
}

# Global mutex around slot reclaim/grab (mkdir is atomic). A lock older than 30 s is from a dead process.
lock() {
  local tries=0
  until mkdir "$Q/.lock" 2>/dev/null; do
    if [ $(( $(now) - $(stat -f %m "$Q/.lock" 2>/dev/null || now) )) -gt 30 ]; then rm -rf "$Q/.lock"; continue; fi
    tries=$((tries+1)); [ $tries -gt 300 ] && return 1; sleep 0.1
  done
}
unlock() { rm -rf "$Q/.lock"; }

# Stop an over-time holder: its command first, then the xq process that owns the slot.
stop_holder() { pkill -TERM -P "$1" 2>/dev/null; kill -TERM "$1" 2>/dev/null; sleep 2; pkill -KILL -P "$1" 2>/dev/null; kill -KILL "$1" 2>/dev/null; }

run() {
  S=$1; shift; SLOT=""
  ME="$Q/queue/$(perl -MTime::HiRes=time -e 'printf "%017.6f", time')-$$"
  echo "$$ $S" > "$Q/queue/.tmp-$$" && mv "$Q/queue/.tmp-$$" "$ME"   # atomic ticket
  trap release EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
  local lastmsg=0 ahead t pid i d
  while :; do
    ahead=0
    for t in "$Q"/queue/*; do          # glob is sorted = oldest ticket first
      [ "$t" = "$ME" ] && break
      read -r pid _ 2>/dev/null < "$t"
      if alive "$pid"; then ahead=$((ahead+1)); else rm -f "$t"; fi
    done
    # Only the head of the queue grabs slots / reclaims stale ones, under the global mutex.
    if [ $ahead -eq 0 ] && lock; then
      for i in $(seq 1 "$SLOTS"); do
        d="$Q/slots/$i"
        if [ -d "$d" ]; then
          pid=""; start=""; read -r pid start _ 2>/dev/null < "$d/info"
          if alive "$pid"; then
            if [ -n "$start" ] && [ $(( $(now) - start )) -gt "$MAX_RUN" ]; then
              echo "xq: slot $i held by pid $pid for over ${MAX_RUN}s; stopping it and freeing the slot" >&2
            elif [ "$(checkin_age "$d")" -gt "$HUNG" ]; then
              echo "xq: slot $i holder pid $pid has not checked in for over ${HUNG}s (hung); stopping it and freeing the slot" >&2
              echo "$(date '+%F %T') auto-kick slot $i: $(cat "$d/info" 2>/dev/null)" >> "$Q/kicks.log"
            else
              continue
            fi
            stop_holder "$pid"
          fi
          [ -z "$pid" ] && [ $(( $(now) - $(stat -f %m "$d") )) -lt 10 ] && continue  # just created
          echo "xq: reclaiming stale slot $i (pid ${pid:-?})" >&2
          rm -rf "$d"
        fi
        mkdir "$d" 2>/dev/null && { echo "$$ $(now) $S $*" > "$d/info"; SLOT=$d; break; }
      done
      unlock
      [ -n "$SLOT" ] && break
    fi
    if [ $(( $(now) - lastmsg )) -ge 30 ]; then
      echo "xq: waiting for a slot ($ahead ahead)" >&2; warn_missed; lastmsg=$(now)
    fi
    sleep 1
  done
  rm -f "$ME"; touch "$Q/seen/$S"; touch "$SLOT/checkin"
  watch_job $$ "$SLOT" </dev/null >/dev/null 2>&1 & WATCH=$!
  echo "xq: [$S] got slot ${SLOT##*/} (busy jobs check in automatically; if you hold it idle, run 'xq checkin $S' every 5 min)" >&2
  # Keep simulators to the running jobs: shut down booted xq-* sims whose session does not hold a slot
  # (xq-<session> and xq-<session>-<suffix> belong to <session>; xcodebuild / simctl boot them again on demand).
  local busy=" " j hp hs
  for j in $(seq 1 "$SLOTS"); do read -r hp _ hs _ 2>/dev/null < "$Q/slots/$j/info" && alive "$hp" && busy="$busy$hs "; done
  xcrun simctl list devices 2>/dev/null | sed -nE "s/^ +xq-([A-Za-z0-9_-]+) \(([0-9A-F-]{36})\) \(Booted\).*/\1 \2/p" |
    while read -r s u; do
      case $s in pool-[0-9]*) pool_idle "$s" "$u"; continue ;; esac
      keep=""; for b in $busy; do [ "$s" = "$b" ] || [ "${s#"$b"-}" != "$s" ] && keep=1; done
      [ -n "$keep" ] || xcrun simctl shutdown "$u" >/dev/null 2>&1
    done
  # Its own subshell: a slip in the disk check must not end a job that already holds the slot.
  ( low_disk ) </dev/null || true
  export XQ_SLOT="${SLOT##*/}" XQ_SESSION="$S"
  "$@"   # foreground: Ctrl-C reaches it; kill -9 of xq orphans it but the slot is reclaimed
  exit $?
}

sim_udid() { xcrun simctl list devices | sed -nE "s/^ +xq-$1 \(([0-9A-F-]{36})\).*/\1/p" | head -1; }
probe() { with_timeout 30 xcrun simctl listapps "$1" >/dev/null 2>&1; }
boot() { with_timeout 180 xcrun simctl bootstatus "$1" -b >/dev/null 2>&1; }

sim() {
  local s=$1 u; u=$(sim_udid "$s")
  if [ -z "$u" ]; then
    u=$(xcrun simctl create "xq-$s" "$DEVICE" "${XQ_RUNTIME:-$RUNTIME_DEFAULT}") || die "could not create xq-$s"
    echo "xq: created xq-$s ($u)" >&2
  fi
  if ! { boot "$u" && probe "$u"; }; then
    echo "xq: xq-$s ($u) failed boot/health probe, rebooting it" >&2
    with_timeout 60 xcrun simctl shutdown "$u" >/dev/null 2>&1
    { boot "$u" && probe "$u"; } || die "xq-$s ($u) is WEDGED: listapps still hangs after a reboot. Try: xcrun simctl erase $u"
  fi
  # The simulator's Photos analysis service (mediaanalysisd) burns several cores during tests; switch it
  # off once per sim (persists across reboots of that sim).
  if [ ! -e "$Q/seen/.mad-$u" ]; then
    for id in user/foreground/com.apple.mediaanalysisd system/com.apple.mediaanalysisd; do
      xcrun simctl spawn "$u" launchctl disable "$id" >/dev/null 2>&1; xcrun simctl spawn "$u" launchctl bootout "$id" >/dev/null 2>&1
    done
    touch "$Q/seen/.mad-$u"
  fi
  touch "$Q/seen/$s"; echo "$u"
}

status() {
  local i pid start s cmd st t f ca; t=$(now)
  echo "slots:"
  for i in $(seq 1 "$SLOTS"); do
    if read -r pid start s cmd 2>/dev/null < "$Q/slots/$i/info"; then
      ca=$(checkin_age "$Q/slots/$i")
      if ! alive "$pid"; then st="  STALE (pid dead)"; elif [ $((t-start)) -gt "$MAX_RUN" ]; then st="  OVER TIME (will be stopped)"
      elif [ "$ca" -gt "$HUNG" ]; then st="  HUNG (no check-in; will be stopped)"; elif [ "$ca" -gt "$CHECKIN" ]; then st="  MISSED CHECK-IN"; else st=""; fi
      printf '  %s: %-14s pid %-6s started %s  elapsed %dm%02ds  last check-in %dm%02ds ago%s\n       %s\n' "$i" "$s" "$pid" \
        "$(date -r "$start" +%H:%M:%S)" $(((t-start)/60)) $(((t-start)%60)) $((ca/60)) $((ca%60)) "$st" "$cmd"
    else echo "  $i: free"; fi
  done
  echo "waiting:"
  for f in "$Q"/queue/*; do [ -e "$f" ] && read -r pid s < "$f" && echo "  $s (pid $pid)"; done
  echo "sims:"
  xcrun simctl list devices | grep -E '^ +xq-' || echo "  (none)"
  echo "pool (xq test, at most $POOL_MAX):"
  pool_sims | while read -r name u st; do
    if lease_live "$name"; then read -r pid _ s _ < "$Q/pool/$name"; echo "  xq-$name $st, leased by $s (pid $pid)"
    else echo "  xq-$name $st, free"; fi
  done
}

checkin() {
  local i pid s
  for i in $(seq 1 "$SLOTS"); do
    read -r pid _ s _ 2>/dev/null < "$Q/slots/$i/info" || continue
    [ "$s" = "$1" ] && alive "$pid" && { touch "$Q/slots/$i/checkin"; echo "xq: [$1] checked in (slot $i)"; return 0; }
  done
  die "session '$1' does not hold a slot"
}

kick() {
  local i d pid s
  for i in $(seq 1 "$SLOTS"); do
    d="$Q/slots/$i"; read -r pid _ s _ 2>/dev/null < "$d/info" || continue
    [ "$s" = "$1" ] || continue
    echo "$(date '+%F %T') kick slot $i by ${XQ_KICKER:-$USER}: $(cat "$d/info" 2>/dev/null)" >> "$Q/kicks.log"
    alive "$pid" && stop_holder "$pid"
    rm -rf "$d"; echo "xq: kicked '$1' (pid $pid) out of slot $i"; return 0
  done
  die "session '$1' does not hold a slot"
}

gc() {
  local busy=" " i pid s u
  for i in $(seq 1 "$SLOTS"); do
    read -r pid _ s _ 2>/dev/null < "$Q/slots/$i/info" && alive "$pid" && { busy="$busy$s "; touch "$Q/seen/$s"; }
  done
  xcrun simctl list devices | sed -nE 's/^ +xq-([A-Za-z0-9_-]+) \(([0-9A-F-]{36})\) \(Booted\).*/\1 \2/p' |
  while read -r s u; do
    case $s in pool-[0-9]*) pool_idle "$s" "$u" && echo "xq gc: shut down idle xq-$s ($u)"; continue ;; esac
    [[ $busy == *" $s "* ]] && continue
    [ -e "$Q/seen/$s" ] || { touch "$Q/seen/$s"; continue; }   # unknown age: start the clock now
    [ -n "$(find "$Q/seen/$s" -mmin +30)" ] || continue
    echo "xq gc: shutting down idle xq-$s ($u)"; xcrun simctl shutdown "$u"
  done
}

# Sessions that hold a live slot or wait for one, space-separated.
busy_sessions() {
  local f pid s out=""
  for f in "$Q"/slots/*/info; do [ -e "$f" ] && read -r pid _ s _ 2>/dev/null < "$f" && alive "$pid" && out="$out $s"; done
  for f in "$Q"/queue/*; do [ -e "$f" ] && read -r pid s _ 2>/dev/null < "$f" && alive "$pid" && out="$out $s"; done
  for f in "$Q"/pool/pool-*; do [ -e "$f" ] && lease_live "${f##*/}" && out="$out ${f##*/}"; done
  echo "$out"
}
# True if simulator $1 (xq-<session> or xq-<session>-<suffix>) belongs to one of the sessions in $2.
owned_by() { local b n=${1#xq-}; for b in $2; do { [ "$n" = "$b" ] || [ "${n#"$b"-}" != "$n" ]; } && return 0; done; return 1; }

# Picks deletable simulators from `simctl list devices -j` on stdin; prints "udid state bytes age-secs name".
# Same rules for prune and drop: run simulators only, never kept or busy ones. A simulator with no known age stays.
read -r -d '' PICK <<'PY'
import fnmatch, json, os, re, sys, time
from datetime import datetime, timezone
mode, arg, q, runtime, devtype, busy, keep = sys.argv[1:8]
busy, keep, now = busy.split(), keep.split(), time.time()
def stamp(s):
    try: return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError: return None
def mtime(p):
    try: return os.path.getmtime(p)
    except OSError: return None
for d in json.load(sys.stdin)["devices"].get(runtime, []):
    n = d.get("name", ""); s = n[3:]
    if not n.startswith("xq-") or d.get("deviceTypeIdentifier") != devtype: continue
    if any(fnmatch.fnmatchcase(n, k) for k in keep): continue
    if any(s == b or s.startswith(b + "-") for b in busy): continue
    if mode == "drop":
        if not re.fullmatch(re.escape(arg) + r"-[0-9]+", s): continue
        age = 0
    else:
        if d.get("state") != "Shutdown": continue
        dp = d.get("dataPath") or ""
        used = [stamp(d.get("lastUsedAt") or ""), stamp(d.get("lastBootedAt") or ""), mtime(os.path.join(q, "seen", s)),
                mtime(os.path.join(os.path.dirname(dp), "device.plist")) if dp else None]
        used = [t for t in used if t]
        if not used: continue
        age = now - max(used)
        if age < float(arg): continue
    print(d["udid"], d.get("state", "?"), int(d.get("dataPathSize") or 0), int(age), n)
PY

# $1 $2: prune <secs> | drop <session>
# The long-lived names: POOL plus the Mac's keep-sims file. Callers expand it with set -f (they are globs).
keep_globs() {
  local keep="$POOL" l w
  if [ -r "$KEEP_FILE" ]; then
    set -f; while IFS= read -r l || [ -n "$l" ]; do l=${l%%#*}; for w in $l; do keep="$keep $w"; done; done < "$KEEP_FILE"; set +f
  fi
  echo "$keep"
}
sim_candidates() {
  local json
  json=$(with_timeout 60 xcrun simctl list devices -j) || return 1
  "$PY" -c "$PICK" "$1" "$2" "$Q" "$RUNTIME_DEFAULT" "$DEVICE_ID" "$(busy_sessions)" "$(keep_globs)" <<<"$json"
}

# 30m, 6h, 2d or plain seconds -> seconds
secs_of() {
  case $1 in
    ''|*[!0-9dhms]*|[dhms]*|*[dhms]*[0-9dhms]) return 1 ;;
    *d) echo $(( ${1%d} * 86400 )) ;; *h) echo $(( ${1%h} * 3600 )) ;; *m) echo $(( ${1%m} * 60 )) ;;
    *s) echo "${1%s}" ;; *) echo "$1" ;;
  esac
}
human_age() { if [ "$1" -ge 86400 ]; then echo "$(($1 / 86400))d"; elif [ "$1" -ge 3600 ]; then echo "$(($1 / 3600))h"; else echo "$(($1 / 60))m"; fi; }
gb() { awk -v b="$1" 'BEGIN{printf "%.1f", b / 1e9}'; }
forget_sim() { rm -f "$Q/seen/${2#xq-}" "$Q/seen/.mad-$1"; }

prune() {
  local age=2d dry="" secs list u st b ag name n=0 bytes=0 verb=deleted tail=""
  while [ $# -gt 0 ]; do
    case $1 in
      --older-than) [ $# -ge 2 ] || die "usage: xq prune [--older-than 2d] [--dry-run]"; age=$2; shift 2 ;;
      --older-than=*) age=${1#*=}; shift ;;
      --dry-run|-n) dry=1; verb="would delete"; shift ;;
      *) die "usage: xq prune [--older-than 2d] [--dry-run]" ;;
    esac
  done
  secs=$(secs_of "$age") || die "--older-than takes 30m, 6h, 2d or seconds, not '$age'"
  if [ -z "$dry" ] && ! mkdir "$Q/.prune" 2>/dev/null; then
    # One prune at a time; a lock older than 15 min is left by a prune that died.
    [ -n "$(find "$Q/.prune" -maxdepth 0 -mmin +15 2>/dev/null)" ] || { echo "xq prune: another prune is running"; return 0; }
    touch "$Q/.prune"
  fi
  list=$(sim_candidates prune "$secs") || { [ -n "$dry" ] || rm -rf "$Q/.prune"; die "could not list simulators"; }
  while read -r u st b ag name; do
    [ -n "$u" ] || continue
    if [ -n "$dry" ]; then
      printf '  would delete %-26s %s  %s GB, unused %s\n' "$name" "$u" "$(gb "$b")" "$(human_age "$ag")"
    else
      # Since the list was made, its session may have started a job or `xq sim` may have booted it. A pool
      # simulator is checked and deleted under the lock that xq lease takes, so a lease can't land in between.
      local locked=""; case $name in xq-pool-*) lock && locked=1 || continue ;; esac
      if owned_by "$name" "$(busy_sessions)" || ! xcrun simctl list devices 2>/dev/null | grep -qF "($u) (Shutdown)"; then
        [ -n "$locked" ] && unlock; continue
      fi
      with_timeout 120 xcrun simctl delete "$u" >/dev/null 2>&1 || { [ -n "$locked" ] && unlock; echo "xq prune: could not delete $name ($u)"; continue; }
      [ -n "$locked" ] && unlock
      forget_sim "$u" "$name"; echo "  deleted $name ($u, $(gb "$b") GB)"
    fi
    n=$((n + 1)); bytes=$((bytes + b))
  done <<<"$list"
  [ -n "$dry" ] || rm -rf "$Q/.prune"
  [ -z "$dry" ] && [ "$n" -gt 0 ] && tail="; macOS frees the space over a few minutes"
  echo "xq prune: $verb $n simulator(s) unused for $age, $(gb "$bytes") GB$tail"
}

# Deletes the simulators of one finished xq test run, after waiting briefly for its own job to leave the slot.
drop() {
  local s=$1 i list u st b ag name n=0
  for i in $(seq 1 "${XQ_DROP_WAIT:-30}"); do owned_by "xq-$s" "$(busy_sessions)" || break; sleep 1; done
  list=$(sim_candidates drop "$s") || die "could not list simulators"
  while read -r u st b ag name; do
    [ -n "$u" ] || continue
    [ "$st" = Shutdown ] || with_timeout 60 xcrun simctl shutdown "$u" >/dev/null 2>&1
    with_timeout 120 xcrun simctl delete "$u" >/dev/null 2>&1 || { echo "xq drop: could not delete $name ($u)"; continue; }
    forget_sim "$u" "$name"; n=$((n + 1))
  done <<<"$list"
  echo "xq drop: deleted $n simulator(s) of $s"
}

# A full disk stops every build, so under LOW_GB free a job first clears out run simulators unused for LOW_AGE.
low_disk() {
  local free; free=$(df -g ~ 2>/dev/null | awk 'NR==2{print $4}')
  case $free in ''|*[!0-9]*) return 0 ;; esac
  [ "$free" -lt "$LOW_GB" ] || return 0
  echo "xq: WARNING only $free GB free on $(hostname -s) (under $LOW_GB GB); deleting run simulators unused for $LOW_AGE" >&2
  prune --older-than "$LOW_AGE" >&2
}

# --- xq test's simulator pool: xq-pool-<k>, shared by every session's runs on this Mac ---
# A lease is $Q/pool/pool-<k> = "pid start session". It holds while that pid lives and for at most MAX_RUN, so a
# killed run's simulators come back by themselves. The wipe happens on the way out (xq ready), not on hand-back,
# so a run that never handed back can't pass on its data. /tmp/xq goes at a reboot, which only ends the leases.
lease_live() { local pid start; read -r pid start _ 2>/dev/null < "$Q/pool/$1" || return 1; alive "$pid" && [ $(( $(now) - start )) -le "$MAX_RUN" ]; }
# "pool-<k> <udid> <Booted|Shutdown>", by k
pool_sims() {
  xcrun simctl list devices 2>/dev/null | sed -nE 's/^ +xq-(pool-[0-9]+) \(([0-9A-F-]{36})\) \((Booted|Shutdown)\).*/\1 \2 \3/p' | sort -t- -k2,2n
}

# $1 session, $2 count, $3 the job's pid. Prints "pool-<k> warm|cold|new" per simulator it got, which can be fewer
# than asked (the pool is full: the caller makes its own as before), or none for a long-lived name like fulltest,
# which keeps its own simulators.
lease() {
  local s=$1 want=$2 pid=$3 g got=0 out="" name u st pass k have
  set -f
  # shellcheck disable=SC2254  # the keep list is globs
  for g in $(keep_globs); do case "xq-$s-1" in $g) set +f; return 0 ;; esac; done
  set +f
  lock || die "could not take the lock"
  have=$(pool_sims)
  for pass in Booted Shutdown; do
    while read -r name u st; do
      [ -n "$name" ] && [ "$st" = "$pass" ] && [ "$got" -lt "$want" ] || continue
      lease_live "$name" && continue
      echo "$pid $(now) $s" > "$Q/pool/$name"; got=$((got + 1))
      [ "$st" = Booted ] && out="$out$name warm\n" || out="$out$name cold\n"
    done <<<"$have"
  done
  k=1
  while [ "$got" -lt "$want" ] && [ "$(grep -c . <<<"$have")" -lt "$POOL_MAX" ]; do
    while grep -q "^pool-$k " <<<"$have"; do k=$((k + 1)); done
    u=$(with_timeout 60 xcrun simctl create "xq-pool-$k" "$DEVICE" "$RUNTIME_DEFAULT" 2>/dev/null) || break
    echo "$pid $(now) $s" > "$Q/pool/pool-$k"; got=$((got + 1)); out="${out}pool-$k new\n"
    have=$(printf '%s\npool-%s %s Shutdown' "$have" "$k" "$u" | grep .)
  done
  unlock
  printf "$out"
}

# Prints the user apps on simulator $1, one bundle id per line. Fails if it can't tell.
user_apps() {
  local j; j=$(with_timeout 30 xcrun simctl listapps "$1" 2>/dev/null | plutil -convert json -o - - 2>/dev/null) || return 1
  "$PY" -c 'import json, sys
for k, v in json.load(sys.stdin).items():
    if v.get("ApplicationType") == "User": print(k)' <<<"$j"
}

# Wipes what the last run left on booted pool simulator $1 ($2 its udid). Removing an app removes its data, its
# app-group and extension containers; the keychain, permission grants and pasteboard survive that, so they are
# reset. Photos, Contacts, Calendar and Health survive too, and a run that wrote to them gets an erase.
pool_wipe() {
  local name=$1 u=$2 dir="$SIM_HOME/$2" a apps left
  if [ -e "$dir/xq-wiped" ] && [ -n "$(cd "$dir/data" 2>/dev/null && find $STORES -newer "$dir/xq-wiped" -type f 2>/dev/null | head -1)" ]; then
    echo "xq: xq-$name: the last run wrote to Photos, Contacts, Calendar or Health; erasing it (one first boot)" >&2
    with_timeout 60 xcrun simctl shutdown "$u" >/dev/null 2>&1
    with_timeout 120 xcrun simctl erase "$u" >/dev/null 2>&1 || return 1
    rm -f "$Q/seen/.mad-$u"; ( sim "$name" ) >/dev/null || return 1
  else
    apps=$(user_apps "$u") || return 1
    for a in $apps; do with_timeout 60 xcrun simctl uninstall "$u" "$a" >/dev/null 2>&1 || return 1; done
    left=$(user_apps "$u") || return 1; [ -z "$left" ] || return 1
    with_timeout 30 xcrun simctl keychain "$u" reset >/dev/null 2>&1 || return 1
    with_timeout 30 xcrun simctl privacy "$u" reset all >/dev/null 2>&1 || return 1
    with_timeout 30 xcrun simctl pbcopy "$u" </dev/null >/dev/null 2>&1 || return 1
  fi
  mkdir -p "$dir" && touch "$dir/xq-wiped"
}

# Deletes pool simulator $1 and its lease: it couldn't be booted or wiped, so nobody gets it.
pool_discard() {
  local u; u=$(sim_udid "$1")
  if [ -n "$u" ]; then
    with_timeout 60 xcrun simctl shutdown "$u" >/dev/null 2>&1
    with_timeout 120 xcrun simctl delete "$u" >/dev/null 2>&1
    forget_sim "$u" "xq-$1"
  fi
  rm -f "$Q/pool/$1"
}

# Boots leased pool simulator $1 and wipes it; prints the UDID. On failure it is deleted and this fails.
ready() {
  local name=$1 u
  lease_live "$name" || die "xq-$name is not leased (xq lease first)"
  if ! u=$(sim "$name") || ! pool_wipe "$name" "$u"; then
    echo "xq: xq-$name could not be booted or wiped; deleting it" >&2
    pool_discard "$name"; return 1
  fi
  echo "$u"
}

# $1 the pid that leased them, then names. Leaves a lease alone that someone else holds now.
unlease() {
  local pid=$1 n p; shift
  for n in "$@"; do
    read -r p _ 2>/dev/null < "$Q/pool/$n" && [ "$p" = "$pid" ] && rm -f "$Q/pool/$n" && touch "$Q/seen/$n"
  done
  return 0
}

# Shuts down pool simulator $1 ($2 udid) if nobody leases it and nobody has used it for POOL_IDLE seconds.
pool_idle() {
  local f="$Q/seen/$1"
  lease_live "$1" && return 1
  [ -e "$f" ] || { touch "$f"; return 1; }   # unknown age: start the clock now
  [ $(( $(now) - $(perl -e 'print +(stat shift)[9]' "$f") )) -gt "$POOL_IDLE" ] || return 1
  xcrun simctl shutdown "$2" >/dev/null 2>&1
}

case "${1:-}" in
  status) status ;;
  lease) [ $# -eq 4 ] && [[ $3 =~ ^[0-9]+$ ]] && [[ $4 =~ ^[0-9]+$ ]] || die "usage: xq lease <session> <n> <pid>"
         check_name "$2"; lease "$2" "$3" "$4" ;;
  ready) [ $# -eq 2 ] && [[ $2 =~ ^pool-[0-9]+$ ]] || die "usage: xq ready pool-<k>"; ready "$2" ;;
  unlease) [ $# -ge 2 ] && [[ $2 =~ ^[0-9]+$ ]] || die "usage: xq unlease <pid> pool-<k>..."
           for n in "${@:3}"; do [[ $n =~ ^pool-[0-9]+$ ]] || die "not a pool simulator: '$n'"; done
           unlease "${@:2}" ;;
  gc) gc ;;
  sim) [ $# -eq 2 ] || die "usage: xq sim <session>"; check_name "$2"; sim "$2" ;;
  checkin) [ $# -eq 2 ] || die "usage: xq checkin <session>"; check_name "$2"; checkin "$2" ;;
  kick) [ $# -eq 2 ] || die "usage: xq kick <session>"; check_name "$2"; kick "$2" ;;
  prune) shift; prune "$@" ;;
  drop) [ $# -eq 2 ] || die "usage: xq drop <session>"; check_name "$2"; drop "$2" ;;
  ""|-h|--help) sed -n '2,/^# Stale jobs/p' "$0" | sed '$d' ;;
  *) [ "${2:-}" = "--" ] && [ $# -ge 3 ] || die "usage: xq <session> -- <command...>  (see xq --help)"
     check_name "$1"; s=$1; shift 2; run "$s" "$@" ;;
esac
