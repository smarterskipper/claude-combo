#!/bin/bash
# xq - build queue + per-session simulators for the shared build Mac. EVERY session
# (Menos, Yarrow, anything) runs xcodebuild / simulator / archive work through it.
#   xq <session> -- <cmd...>   run cmd when the slot is free; jobs start strictly in arrival order
#   xq sim <session>           print UDID of sim "xq-<session>" (create, boot, health-check)
#   xq status                  slot holders, waiters, xq-* sims, last check-in
#   xq checkin <session>       the session holding the slot says "still alive" (do this every 5 min
#                              while you hold it for anything idle; busy jobs check in on their own)
#   xq kick <session>          stop that session's job and free the slot (only after asking the
#                              other sessions and nobody claimed it)
#   xq gc                      shut down xq-* sims whose session has been idle > 30 min
# Stale jobs are removed: a waiter whose session died leaves the line; a slot whose holder
# died, or that has run longer than XQ_MAX_RUN seconds (default 5400 = 90 min), is freed
# (an over-time holder is stopped first). Check-ins: a holder that keeps using CPU checks in
# automatically every XQ_BEAT s (60); otherwise its session must run `xq checkin <session>`.
# No check-in for XQ_CHECKIN s (300) = MISSED (waiters are warned); for XQ_HUNG s (600) = HUNG,
# and the head waiter stops it and takes the slot.
# Env: XQ_SLOTS (default 3 since 2026-10-17 night, Boston; was 2 since 2026-10-11 — backup ~/bin/xq.bak-2slots-20261017), XQ_MAX_RUN, XQ_BEAT, XQ_CHECKIN, XQ_HUNG.
# Jobs get XQ_SLOT (slot number) and XQ_SESSION in their environment (used by ~/bin/ci for warm lanes).
# State lives in /tmp/xq. Only ever touches simulators named xq-*.
set -u
Q=${XQ_DIR:-/tmp/xq}; SLOTS=${XQ_MAC_SLOTS:-3}; MAX_RUN=${XQ_MAX_RUN:-5400}; DEVICE="iPhone 17 Pro"
BEAT=${XQ_BEAT:-60}; CHECKIN=${XQ_CHECKIN:-300}; HUNG=${XQ_HUNG:-600}
mkdir -p "$Q/slots" "$Q/queue" "$Q/seen"

die() { echo "xq: $*" >&2; exit 1; }
now() { date +%s; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
# macOS has no `timeout`; SIGALRM survives exec and kills the command.
with_timeout() { local s=$1; shift; perl -e 'alarm shift; exec @ARGV or die' "$s" "$@"; }
check_name() { [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "session name must match [A-Za-z0-9_-]+: '$1'"; }

# Frees the slot only while it is still ours: if it was reclaimed and handed on, the new holder keeps it
# (removing it let a third job in, whose ci run then killed the new holder: slot 1 ping-ponged, 2026-10-24).
release() {
  local holder=""
  [ -n "${WATCH:-}" ] && kill "$WATCH" 2>/dev/null; rm -f "$ME"
  [ -n "$SLOT" ] && read -r holder _ 2>/dev/null < "$SLOT/info"; [ -n "$SLOT" ] && [ "$holder" = "$$" ] && rm -rf "$SLOT"
  touch "$Q/seen/$S"
}

# Seconds since the slot's holder last checked in (slot dir mtime if it never did).
checkin_age() { local f="$1/checkin"; [ -e "$f" ] || f="$1"; echo $(( $(now) - $(stat -f %m "$f" 2>/dev/null || now) )); }

# Total CPU seconds of every process under pid $1, skipping the subtree rooted at pid $2 (the watcher).
tree_cpu() {
  ps -A -o pid=,ppid=,time= | awk -v root="$1" -v skip="$2" '
    { pid=$1; pp[pid]=$2; n=split($3,a,":"); t=0; for(i=1;i<=n;i++) t=t*60+a[i]; cpu[pid]=t }
    END { for (p in pp) { q=p; ok=0
            while (q != "" && q > 1) { if (q==skip) break; if (q==root) { ok=1; break }; q=pp[q] }
            if (ok && p!=root) s+=cpu[p] }
          printf "%.2f\n", s+0 }'
}

# Background: touch the slot's checkin file whenever the job used CPU since the last beat.
watch_job() {
  local holder=$1 slot=$2 last cur me
  me=$(exec sh -c 'echo $PPID')   # this background subshell's pid (bash 3.2 has no $BASHPID)
  last=$(tree_cpu "$holder" "$me")
  while sleep "$BEAT"; do
    [ -d "$slot" ] || exit 0; alive "$holder" || exit 0
    cur=$(tree_cpu "$holder" "$me")
    awk -v a="$cur" -v b="$last" 'BEGIN{exit !(a>b)}' && touch "$slot/checkin"
    last=$cur
  done
}

# Warn (to stderr) about any live holder that has missed its check-in.
warn_missed() {
  local i d pid start s age
  for i in $(seq 1 "$SLOTS"); do
    d="$Q/slots/$i"; read -r pid start s _ 2>/dev/null < "$d/info" || continue
    alive "$pid" || continue
    age=$(checkin_age "$d"); [ "$age" -gt "$CHECKIN" ] || continue
    echo "xq: slot $i holder '$s' (pid $pid) has not checked in for $((age/60))m$((age%60))s. If it's yours: xq checkin $s. Otherwise ask the other sessions (ListAgents + SendMessage) whether it's hung; if nobody claims it: xq kick $s. It is freed automatically at $((HUNG/60))m without a check-in." >&2
  done
}

# Global mutex around slot reclaim/grab (mkdir is atomic). A lock older than 30 s is from a dead process.
lock() {
  local tries=0
  until mkdir "$Q/.lock" 2>/dev/null; do
    if [ $(( $(now) - $(stat -f %m "$Q/.lock" 2>/dev/null || now) )) -gt 30 ]; then rm -rf "$Q/.lock"; continue; fi
    tries=$((tries+1)); [ $tries -gt 300 ] && return 1; sleep 0.1
  done
}
unlock() { rm -rf "$Q/.lock"; }

# Stop an over-time holder: its command first, then the xq process that owns the slot.
stop_holder() { pkill -TERM -P "$1" 2>/dev/null; kill -TERM "$1" 2>/dev/null; sleep 2; pkill -KILL -P "$1" 2>/dev/null; kill -KILL "$1" 2>/dev/null; }

run() {
  S=$1; shift; SLOT=""
  ME="$Q/queue/$(perl -MTime::HiRes=time -e 'printf "%017.6f", time')-$$"
  echo "$$ $S" > "$Q/queue/.tmp-$$" && mv "$Q/queue/.tmp-$$" "$ME"   # atomic ticket
  trap release EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
  local lastmsg=0 ahead t pid i d
  while :; do
    ahead=0
    for t in "$Q"/queue/*; do          # glob is sorted = oldest ticket first
      [ "$t" = "$ME" ] && break
      read -r pid _ 2>/dev/null < "$t"
      if alive "$pid"; then ahead=$((ahead+1)); else rm -f "$t"; fi
    done
    # Only the head of the queue grabs slots / reclaims stale ones, under the global mutex.
    if [ $ahead -eq 0 ] && lock; then
      for i in $(seq 1 "$SLOTS"); do
        d="$Q/slots/$i"
        if [ -d "$d" ]; then
          pid=""; start=""; read -r pid start _ 2>/dev/null < "$d/info"
          if alive "$pid"; then
            if [ -n "$start" ] && [ $(( $(now) - start )) -gt "$MAX_RUN" ]; then
              echo "xq: slot $i held by pid $pid for over ${MAX_RUN}s; stopping it and freeing the slot" >&2
            elif [ "$(checkin_age "$d")" -gt "$HUNG" ]; then
              echo "xq: slot $i holder pid $pid has not checked in for over ${HUNG}s (hung); stopping it and freeing the slot" >&2
              echo "$(date '+%F %T') auto-kick slot $i: $(cat "$d/info" 2>/dev/null)" >> "$Q/kicks.log"
            else
              continue
            fi
            stop_holder "$pid"
          fi
          [ -z "$pid" ] && [ $(( $(now) - $(stat -f %m "$d") )) -lt 10 ] && continue  # just created
          echo "xq: reclaiming stale slot $i (pid ${pid:-?})" >&2
          rm -rf "$d"
        fi
        mkdir "$d" 2>/dev/null && { echo "$$ $(now) $S $*" > "$d/info"; SLOT=$d; break; }
      done
      unlock
      [ -n "$SLOT" ] && break
    fi
    if [ $(( $(now) - lastmsg )) -ge 30 ]; then
      echo "xq: waiting for a slot ($ahead ahead)" >&2; warn_missed; lastmsg=$(now)
    fi
    sleep 1
  done
  rm -f "$ME"; touch "$Q/seen/$S"; touch "$SLOT/checkin"
  watch_job $$ "$SLOT" </dev/null >/dev/null 2>&1 & WATCH=$!
  echo "xq: [$S] got slot ${SLOT##*/} (busy jobs check in automatically; if you hold it idle, run 'xq checkin $S' every 5 min)" >&2
  # Keep simulators to the running jobs: shut down booted xq-* sims whose session does not hold a slot
  # (xq-<session> and xq-<session>-<suffix> belong to <session>; xcodebuild / simctl boot them again on demand).
  local busy=" " j hp hs
  for j in $(seq 1 "$SLOTS"); do read -r hp _ hs _ 2>/dev/null < "$Q/slots/$j/info" && alive "$hp" && busy="$busy$hs "; done
  xcrun simctl list devices 2>/dev/null | sed -nE "s/^ +xq-([A-Za-z0-9_-]+) \(([0-9A-F-]{36})\) \(Booted\).*/\1 \2/p" |
    while read -r s u; do
      keep=""; for b in $busy; do [ "$s" = "$b" ] || [ "${s#"$b"-}" != "$s" ] && keep=1; done
      [ -n "$keep" ] || xcrun simctl shutdown "$u" >/dev/null 2>&1
    done
  export XQ_SLOT="${SLOT##*/}" XQ_SESSION="$S"
  "$@"   # foreground: Ctrl-C reaches it; kill -9 of xq orphans it but the slot is reclaimed
  exit $?
}

sim_udid() { xcrun simctl list devices | sed -nE "s/^ +xq-$1 \(([0-9A-F-]{36})\).*/\1/p" | head -1; }
probe() { with_timeout 30 xcrun simctl listapps "$1" >/dev/null 2>&1; }
boot() { with_timeout 180 xcrun simctl bootstatus "$1" -b >/dev/null 2>&1; }

sim() {
  local s=$1 u; u=$(sim_udid "$s")
  if [ -z "$u" ]; then
    u=$(xcrun simctl create "xq-$s" "$DEVICE" "${XQ_RUNTIME:-com.apple.CoreSimulator.SimRuntime.iOS-26-4}") || die "could not create xq-$s"
    echo "xq: created xq-$s ($u)" >&2
  fi
  if ! { boot "$u" && probe "$u"; }; then
    echo "xq: xq-$s ($u) failed boot/health probe, rebooting it" >&2
    with_timeout 60 xcrun simctl shutdown "$u" >/dev/null 2>&1
    { boot "$u" && probe "$u"; } || die "xq-$s ($u) is WEDGED: listapps still hangs after a reboot. Try: xcrun simctl erase $u"
  fi
  # The simulator's Photos analysis service (mediaanalysisd) burns several cores during tests; switch it
  # off once per sim (persists across reboots of that sim).
  if [ ! -e "$Q/seen/.mad-$u" ]; then
    for id in user/foreground/com.apple.mediaanalysisd system/com.apple.mediaanalysisd; do
      xcrun simctl spawn "$u" launchctl disable "$id" >/dev/null 2>&1; xcrun simctl spawn "$u" launchctl bootout "$id" >/dev/null 2>&1
    done
    touch "$Q/seen/.mad-$u"
  fi
  touch "$Q/seen/$s"; echo "$u"
}

status() {
  local i pid start s cmd st t f ca; t=$(now)
  echo "slots:"
  for i in $(seq 1 "$SLOTS"); do
    if read -r pid start s cmd 2>/dev/null < "$Q/slots/$i/info"; then
      ca=$(checkin_age "$Q/slots/$i")
      if ! alive "$pid"; then st="  STALE (pid dead)"; elif [ $((t-start)) -gt "$MAX_RUN" ]; then st="  OVER TIME (will be stopped)"
      elif [ "$ca" -gt "$HUNG" ]; then st="  HUNG (no check-in; will be stopped)"; elif [ "$ca" -gt "$CHECKIN" ]; then st="  MISSED CHECK-IN"; else st=""; fi
      printf '  %s: %-14s pid %-6s started %s  elapsed %dm%02ds  last check-in %dm%02ds ago%s\n       %s\n' "$i" "$s" "$pid" \
        "$(date -r "$start" +%H:%M:%S)" $(((t-start)/60)) $(((t-start)%60)) $((ca/60)) $((ca%60)) "$st" "$cmd"
    else echo "  $i: free"; fi
  done
  echo "waiting:"
  for f in "$Q"/queue/*; do [ -e "$f" ] && read -r pid s < "$f" && echo "  $s (pid $pid)"; done
  echo "sims:"
  xcrun simctl list devices | grep -E '^ +xq-' || echo "  (none)"
}

checkin() {
  local i pid s
  for i in $(seq 1 "$SLOTS"); do
    read -r pid _ s _ 2>/dev/null < "$Q/slots/$i/info" || continue
    [ "$s" = "$1" ] && alive "$pid" && { touch "$Q/slots/$i/checkin"; echo "xq: [$1] checked in (slot $i)"; return 0; }
  done
  die "session '$1' does not hold a slot"
}

kick() {
  local i d pid s
  for i in $(seq 1 "$SLOTS"); do
    d="$Q/slots/$i"; read -r pid _ s _ 2>/dev/null < "$d/info" || continue
    [ "$s" = "$1" ] || continue
    echo "$(date '+%F %T') kick slot $i by ${XQ_KICKER:-$USER}: $(cat "$d/info" 2>/dev/null)" >> "$Q/kicks.log"
    alive "$pid" && stop_holder "$pid"
    rm -rf "$d"; echo "xq: kicked '$1' (pid $pid) out of slot $i"; return 0
  done
  die "session '$1' does not hold a slot"
}

gc() {
  local busy=" " i pid s u
  for i in $(seq 1 "$SLOTS"); do
    read -r pid _ s _ 2>/dev/null < "$Q/slots/$i/info" && alive "$pid" && { busy="$busy$s "; touch "$Q/seen/$s"; }
  done
  xcrun simctl list devices | sed -nE 's/^ +xq-([A-Za-z0-9_-]+) \(([0-9A-F-]{36})\) \(Booted\).*/\1 \2/p' |
  while read -r s u; do
    [[ $busy == *" $s "* ]] && continue
    [ -e "$Q/seen/$s" ] || { touch "$Q/seen/$s"; continue; }   # unknown age: start the clock now
    [ -n "$(find "$Q/seen/$s" -mmin +30)" ] || continue
    echo "xq gc: shutting down idle xq-$s ($u)"; xcrun simctl shutdown "$u"
  done
}

case "${1:-}" in
  status) status ;;
  gc) gc ;;
  sim) [ $# -eq 2 ] || die "usage: xq sim <session>"; check_name "$2"; sim "$2" ;;
  checkin) [ $# -eq 2 ] || die "usage: xq checkin <session>"; check_name "$2"; checkin "$2" ;;
  kick) [ $# -eq 2 ] || die "usage: xq kick <session>"; check_name "$2"; kick "$2" ;;
  ""|-h|--help) sed -n '2,11p' "$0" ;;
  *) [ "${2:-}" = "--" ] && [ $# -ge 3 ] || die "usage: xq <session> -- <command...>  (see xq --help)"
     check_name "$1"; s=$1; shift 2; run "$s" "$@" ;;
esac
